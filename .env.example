# Copy to .env and adjust. Never commit .env.
# Every variable is validated at startup (packages/platform/src/config.ts).

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
HOST=0.0.0.0
PORT=4000
# Public origin of the web app (used for CSRF origin checks and links in emails).
WEB_ORIGIN=http://localhost:3000
# Additional origins allowed to send state-changing requests (comma separated).
ALLOWED_ORIGINS=
# true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# --- PostgreSQL (required) ---
# Neon: use the *pooled* connection string and keep ?sslmode=require.
DATABASE_URL=postgres://civicpulse:civicpulse@localhost:5432/civicpulse_dev
# Optional: direct (non-pooled) owner connection used only for migrations.
# DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=10

# --- Sessions ---
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-secret-change-me-dev-only-secret
SESSION_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_HOURS=720

# --- Features ---
RATE_LIMIT_ENABLED=true
API_DOCS_ENABLED=true
# Let any signed-in user create an organization (they become its administrator).
SELF_SERVICE_ORGANIZATIONS=true

# --- Uploads ---
# "local" keeps photos on disk under STORAGE_LOCAL_DIR (relative to apps/api).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
UPLOAD_MAX_BYTES=8388608

# --- Background processing ---
# true: the API process also relays events and creates notifications.
EMBEDDED_WORKERS=true

# --- Email ---
# "log" writes emails to the API log instead of sending them.
EMAIL_DRIVER=log
EMAIL_FROM=CivicPulse <no-reply@civicpulse.local>

# --- Web (apps/web) ---
# Where the Next.js server forwards /api/* requests.
API_INTERNAL_URL=http://localhost:4000
