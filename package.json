{
  "name": "civicpulse",
  "private": true,
  "version": "0.1.0",
  "description": "Smart community issue reporting and resolution platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @civicpulse/api --filter @civicpulse/web dev",
    "dev:api": "pnpm --filter @civicpulse/api dev",
    "dev:web": "pnpm --filter @civicpulse/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @civicpulse/db generate",
    "db:migrate": "pnpm --filter @civicpulse/db migrate",
    "db:seed": "pnpm --filter @civicpulse/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
